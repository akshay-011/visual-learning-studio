# Visual Learning Studio Environment Configuration
# ZERO-COST POLICY: All external paid services remain disabled by default.

# Hardware Profile override (auto | lightweight | balanced | high_performance)
VLS_HARDWARE_PROFILE=auto

# Local Ollama endpoint for AI research & scriptwriting
VLS_OLLAMA_HOST=http://127.0.0.1:11434
VLS_OLLAMA_MODEL=qwen2.5-coder:7b

# Local TTS Engine (edge-tts | piper)
VLS_TTS_ENGINE=edge-tts
VLS_TTS_DEFAULT_VOICE=en-US-ChristopherNeural

# Visual Rendering Settings
VLS_RESOLUTION=1920x1080
VLS_FPS=30
VLS_FFMPEG_ENCODER=auto

# Optional Local Wan2GP MCP Endpoint (if running external high-VRAM GPU server)
# VLS_WAN2GP_MCP_URL=http://127.0.0.1:7866/mcp
